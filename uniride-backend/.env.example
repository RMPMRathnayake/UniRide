# =============================================================================
# UniEats & UniRide — Environment Configuration Example (.env.example)
# Copy this file to `uniride-backend/.env` for local development.
# Never commit real credentials or secrets to version control.
# =============================================================================

# 1. Server Port
PORT=5000

# 2. Persistent MongoDB Connection URI
# Note: No in-memory database fallback is used; MongoDB must be running locally.
MONGO_URI=mongodb://127.0.0.1:27017/uniEatsDB

# 3. OpenStreetMap Overpass Discovery Provider Settings
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_MS=8000
OVERPASS_MAX_RETRIES=2

# 4. Geographic Discovery Cache & Search Limits
# Cache TTL in milliseconds (default: 900000 = 15 minutes)
DISCOVERY_CACHE_TTL_MS=900000
# Default and maximum shop search radius in meters (default: 2km, max: 10km)
DEFAULT_DISCOVERY_RADIUS_M=2000
MAX_DISCOVERY_RADIUS_M=10000
MAX_DISCOVERY_RESULTS=60

# 5. Discovery Endpoint Sliding-Window Rate Limiter
DISCOVERY_RATE_LIMIT_WINDOW_MS=60000
DISCOVERY_RATE_LIMIT_MAX=30

# 6. Receipt Upload Storage & Validation Settings
# Relative to `uniride-backend/` directory; stored outside public static assets
RECEIPT_STORAGE_DIR=storage/receipts
# Maximum receipt image size in bytes (default: 5242880 = 5 MB)
MAX_RECEIPT_SIZE_BYTES=5242880

# 7. Rider & Quote Eligibility Windows
# Max age of rider GPS coordinates to be eligible for nearby job dispatch (ms)
RIDER_LOCATION_MAX_AGE_MS=7200000
# Quote approval validity window before expiration (ms)
QUOTE_APPROVAL_TTL_MS=1800000

# 8. Prototype Payment & Demo Session Mode
# Functional payment mode is Cash on Delivery (COD). Card mode is labeled simulation only.
PROTOTYPE_PAYMENT_MODE=COD
DEMO_SESSION_SECRET=replace-with-local-random-secret
